{
  "name": "backend",
  "version": "1.0.0",
  "description": "TodoList Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:test": "node src/db/testConnection.js",
    "db:reset": "psql -U todolist_user -d todolist_dev -f ../database/reset.sql",
    "db:schema": "psql -U todolist_user -d todolist_dev -f ../database/schema.sql",
    "db:seed": "psql -U todolist_user -d todolist_dev -f ../database/seed.sql",
    "db:migrate": "npm run db:reset && npm run db:schema && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}